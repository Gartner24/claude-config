+type Disk = Map<string, string | Uint8Array>
+const b64 = (v: string | Uint8Array) => btoa(Array.from(typeof v === 'string' ? new TextEncoder().encode(v) : v, b => String.fromCharCode(b)).join(''))
+const T = '/repo/src/sum.test.ts'
+const WEAK = SPEC.replace('    expect(sum(-1, 1)).toEqual(0)\n', '')
+const MORE = SPEC.replace('})\n', "  it('negatives', () => {\n    expect(sum(-1, -1)).toBe(-2)\n  })\n})\n")
+
+// A disk, git and shell beneath the plugin, answering every call it makes in
+// the shapes the engine does. `head` is what git committed (repo relative);
+// `w.sh` does to the disk what the Bash command would; `w.log` lists the
+// writes and processes the plugin made besides git.
+function world(on: Parameters<TestBody>[1], files: Record<string, string | Uint8Array>, head: Record<string, string> = { 'src/sum.test.ts': SPEC }) {
+  const w = {
+    disk: new Map(Object.entries(files)) as Disk,
+    log: [] as string[],
+    // Paths `test -L` calls a symlink.
+    links: new Set<string>(),
+    runs: 0,
+    sh: (_disk: Disk): void => {},
+    answer: (): { result: unknown } | { deny: string } => ({ result: { stdout: 'built', stderr: '', interrupted: false } }),
+    // Called on every fs.read: lets another writer step in between reads.
+    onRead: (_path: string) => {},
+    // Called on every fs.write before it lands: throw to make the write fail.
+    onWrite: (_path: string) => {},
+  }
+  const isDir = (p: string) => p === '/' || p === '/repo' || [...w.disk.keys()].some(k => k.startsWith(`${p}/`))
+  on('session.cwd', () => ({ value: '/repo' }))
+  on('fs.exists', (_$, e) => ({ value: w.disk.has(e.path) || isDir(e.path) }))
+  on('fs.read', (_$, e) => {
+    const v = w.disk.get(e.path)
+    // Only folders exist without an entry here; reading one fails as the OS does.
+    if (v === undefined) throw new Error(`EISDIR: illegal operation on a directory, read '${e.path}'`)
+    w.onRead(e.path)
+    return { value: e.as === 'bytes' ? { base64: b64(v) } : String(v) }
+  })
+  on('fs.write', (_$, e) => {
+    w.onWrite(e.path)
+    w.log.push(`write ${e.path}`)
+    w.disk.set(e.path, e.text)
+    return { value: undefined }
+  })
+  on('process.run', (_$, e) => {
+    const argv = e.argv
+    if (argv[0] === 'git') {
+      if (argv.includes('rev-parse')) return run('/repo\n')
+      const rel = argv[argv.length - 1]!.slice('HEAD:'.length)
+      return head[rel] !== undefined ? run(head[rel]!) : run('', 128, `fatal: path '${rel}' does not exist in 'HEAD'`)
+    }
+    w.log.push(argv.join(' '))
+    if (argv[0] === 'stat') return run('755\n')
+    if (argv[0] === 'test') return run('', w.links.has(argv[argv.length - 1]!) ? 0 : 1)
+    if (argv[0] === 'rm') {
+      w.disk.delete(argv[argv.length - 1]!)
+      w.links.delete(argv[argv.length - 1]!)
+    }
+    return run('')
+  })
+  on('tool.call', () => {
+    w.runs += 1
+    w.sh(w.disk)
+    return w.answer()
+  })
+  return w
+}
