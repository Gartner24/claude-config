{
  "cleanupPeriodDays": 365,
  "includeCoAuthoredBy": false,
  "enableAllProjectMcpServers": false,
  "env": {
    "ENABLE_STOP_REVIEW": "0",
    "AUTO_HANDOFF_TOKENS": "250000"
  },
  "permissions": {
    "allow": [
      "Bash(~/.claude/skills/jjstack/bin/jjstack-rollover-slot *)",
      "Bash(gh pr ready * -R Gartner24/*)",
      "Bash(gh pr ready * --repo Gartner24/*)",
      "Bash(gh pr merge * -R Gartner24/*)",
      "Bash(gh pr merge * --repo Gartner24/*)",
      "Bash(gh pr view * -R Gartner24/*)",
      "Bash(gh pr close * -R Gartner24/*)",
      "Bash(gio trash *)",
      "Bash(python3 /home/santiago/claude-config/tools/bin/claude-config.py drift)",
      "Bash(python3 /home/santiago/claude-config/tools/bin/claude-config.py hook-files)",
      "Bash(python3 /home/santiago/claude-config/tools/bin/claude-config.py update --plan)",
      "Bash(python3 /home/santiago/claude-config/tools/scripts/skill-keep.py *)",
      "Bash(bash /home/santiago/.claude/conductor/lastsaid.sh)",
      "Bash(bash /home/santiago/.claude/conductor/lastsaid.sh *)",
      "Read(~/.claude/projects/**)",
      "Workflow"
    ],
    "deny": [
      "Bash(fdisk *)",
      "Bash(halt *)",
      "Bash(mkfs*)",
      "Bash(parted *)",
      "Bash(poweroff *)",
      "Bash(reboot *)",
      "Bash(shutdown *)",
      "Bash(sudo dd *)",
      "Bash(sudo mkfs*)",
      "Bash(sudo rm *)",
      "Edit(//home/santiago/.aws/**)",
      "Edit(//home/santiago/.bash_profile)",
      "Edit(//home/santiago/.bashrc)",
      "Edit(//home/santiago/.profile)",
      "Edit(//home/santiago/.ssh/**)",
      "Edit(//home/santiago/.zprofile)",
      "Edit(//home/santiago/.zshenv)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pem)",
      "Read(**/*.pfx)",
      "Read(**/.aws/credentials)",
      "Read(**/.env.prod)",
      "Read(**/.env.production)",
      "Read(**/.env.production.local)",
      "Read(**/.pgpass)",
      "Read(**/.ssh/id_*)",
      "Read(**/id_ed25519)",
      "Read(**/id_rsa)",
      "Read(**/secrets/**)",
      "Read(//home/santiago/.aws/**)",
      "Read(//home/santiago/.claude/.credentials.json)",
      "Read(//home/santiago/.claude/anthropic_api_key)",
      "Read(//home/santiago/.ssh/**)",
      "Edit(//home/santiago/.config/claude-fb/keys.env)",
      "Read(//home/santiago/.config/claude-fb/keys.env)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/santiago/.claude/hooks/workflow-start.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/santiago/.claude/hooks/handover-start.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/santiago/.claude/hooks/claude-config-reminder.py",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/santiago/.claude/hooks/no-jjstack-bar.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node \"/home/santiago/.claude/hooks/context-monitor.js\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/error-detector.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/santiago/.claude/hooks/plain-panel.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/santiago/.claude/hooks/block-destructive.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/santiago/.claude/hooks/profile-lock.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/santiago/.claude/hooks/live-tick.py",
            "timeout": 65
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/injection-guard.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/permission-floor.py"
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/santiago/.claude/hooks/skill-rules.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/auto-approve-safe.sh"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "mcp__",
        "hooks": [
          {
            "type": "command",
            "command": "/home/santiago/.claude/skills/jjstack/hooks/mcp-reconnect.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/santiago/.claude/skills/gstack/hosts/claude/hooks/timeline-stop-hook",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/santiago/.claude/hooks/chain-catch.py",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/santiago/.claude/hooks/skill-rules.py",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/notify-sound.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": false,
    "clangd-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true,
    "ponytail@ponytail": true,
    "security-guidance@claude-plugins-official": true,
    "claude-seo@agricidaniel-claude-seo": false,
    "watch@claude-video": true
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "agricidaniel-claude-seo": {
      "source": {
        "source": "github",
        "repo": "AgriciDaniel/claude-seo"
      }
    },
    "claude-video": {
      "source": {
        "source": "github",
        "repo": "bradautomates/claude-video"
      }
    }
  },
  "spinnerTipsEnabled": false,
  "alwaysThinkingEnabled": true,
  "autoCompactWindow": 700000,
  "tui": "fullscreen",
  "claudeMdExcludes": [
    "/home/santiago/.claude/rules/ecc/**"
  ],
  "theme": "dark-daltonized",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": false,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": false,
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "medium"
    },
    "claude-opus-4-8": {
      "effortLevel": "medium"
    },
    "claude-sonnet-5": {
      "effortLevel": "medium"
    },
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  }
}
