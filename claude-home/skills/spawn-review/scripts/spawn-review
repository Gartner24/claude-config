#!/usr/bin/env bash
# spawn-review - start a second Claude session on an isolated worktree.
#
# The problem it solves: one repo directory can only be on one branch. So reviewing
# a PR or another branch while you keep coding means either stashing your work and
# switching (destructive, and you lose your place), or hand-rolling three commands
# every time and forgetting to clean up after. Stale worktrees pile up because
# `git worktree prune` is nobody's habit.
#
# What it does NOT do: create a session inside your current one. A Claude session is
# an OS process in a terminal - it has nothing to do with your current turn. This
# opens a terminal for you, in the right place, on the right branch.
#
#   spawn-review 123            a GitHub PR by number
#   spawn-review some-branch    any ref
#   spawn-review 123 --prompt "focus on the migration"
#   spawn-review --list         what is currently spawned
#   spawn-review --cleanup      remove every worktree this created
#
# Without tmux it prints the two commands to run instead of guessing at your setup.
set -euo pipefail

BOLD=$'\033[1m'; DIM=$'\033[2m'; GRN=$'\033[32m'; YEL=$'\033[33m'; RST=$'\033[0m'
die() { echo "${YEL}error${RST} $*" >&2; exit 1; }

git rev-parse --git-dir >/dev/null 2>&1 || die "not inside a git repository"
REPO="$(git rev-parse --show-toplevel)"
WT_ROOT="$REPO/.spawn-review-worktrees"
PROMPT=""
TARGET=""
CLAUDE_FLAGS=""

while [ $# -gt 0 ]; do
  case "$1" in
    --prompt) PROMPT="${2:-}"; shift 2 ;;
    --list)
      echo "${BOLD}spawned worktrees${RST}"
      git -C "$REPO" worktree list | grep -F ".spawn-review-worktrees" || echo "  none"
      exit 0 ;;
    --cleanup)
      n=0
      while read -r p _; do
        case "$p" in *".spawn-review-worktrees"*)
          git -C "$REPO" worktree remove --force "$p" 2>/dev/null && {
            echo "  removed $(basename "$p")"; n=$((n + 1)); } ;;
        esac
      done < <(git -C "$REPO" worktree list)
      git -C "$REPO" worktree prune
      # branches this script created, only if fully merged or unused
      git -C "$REPO" for-each-ref --format='%(refname:short)' refs/heads/review/ \
        | while read -r b; do git -C "$REPO" branch -D "$b" >/dev/null 2>&1 && echo "  deleted branch $b"; done
      echo "${GRN}cleaned $n worktree(s)${RST}"
      exit 0 ;;
    -h|--help) sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) die "unknown flag: $1" ;;
    *) TARGET="$1"; shift ;;
  esac
done

[ -n "$TARGET" ] || die "give me a PR number or a ref. --help for usage."

mkdir -p "$WT_ROOT"
# Keep the worktree dir out of git's sight without touching a tracked .gitignore.
EXCL="$(git -C "$REPO" rev-parse --absolute-git-dir)/info/exclude"
grep -qxF ".spawn-review-worktrees/" "$EXCL" 2>/dev/null || echo ".spawn-review-worktrees/" >> "$EXCL"

slug=$(echo "$TARGET" | tr -c 'A-Za-z0-9._-' '-' | sed 's/-\+/-/g;s/^-//;s/-$//')
WT="$WT_ROOT/$slug"
[ -e "$WT" ] && die "$WT already exists. Enter it, or run --cleanup first."

if [[ "$TARGET" =~ ^[0-9]+$ ]]; then
  command -v gh >/dev/null || die "gh is not installed, so a PR number cannot be resolved"
  SLUG=$(gh repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null || true)
  [ -n "$SLUG" ] || die "gh could not resolve this repo (not a GitHub remote, or not authenticated)"
  TITLE=$(gh pr view "$TARGET" --repo "$SLUG" --json title -q .title 2>/dev/null) \
    || die "PR #$TARGET not found in $SLUG"
  # The title is someone else's text; no terminal escapes reach the screen.
  TITLE=$(printf '%s' "$TITLE" | tr -d '\000-\037\177')
  echo "${DIM}fetching PR #$TARGET from $SLUG${RST}"
  git -C "$REPO" fetch -q origin "pull/$TARGET/head:refs/heads/review/pr-$TARGET" 2>/dev/null \
    || git -C "$REPO" fetch -q origin "pull/$TARGET/head" \
    && git -C "$REPO" branch -f "review/pr-$TARGET" FETCH_HEAD >/dev/null 2>&1 || true
  git -C "$REPO" worktree add -q "$WT" "review/pr-$TARGET"
  WHAT="PR #$TARGET - $TITLE"
  REVIEW_ARG="$TARGET"
  # A PR's own .claude/ settings, hooks and MCP servers would run its code; load only yours.
  CLAUDE_FLAGS="--setting-sources user --strict-mcp-config "
else
  git -C "$REPO" rev-parse --verify -q "$TARGET" >/dev/null || die "no such ref: $TARGET"
  # --detach so a branch already checked out in the main worktree still works
  git -C "$REPO" worktree add -q --detach "$WT" "$TARGET"
  WHAT="branch $TARGET"
  REVIEW_ARG="$TARGET"
fi

# `|| true`: origin/HEAD is unset in most repos that were not freshly cloned, and
# under `set -e` a failing command substitution aborts the script.
BASE=$(git -C "$REPO" symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null | sed 's|^origin/||' || true)
[ -n "$BASE" ] || BASE=$(git -C "$REPO" rev-parse --abbrev-ref HEAD 2>/dev/null || echo main)
SEED="/review-stack $REVIEW_ARG"
[ -n "$PROMPT" ] && SEED="$SEED

Note from whoever spawned this: $PROMPT"

echo "${GRN}worktree${RST} $WT"
echo "${DIM}         $WHAT, base $BASE - your own branch and working tree are untouched${RST}"

if command -v claude >/dev/null 2>&1 && command -v tmux >/dev/null 2>&1; then
  WIN="review-$slug"
  if [ -n "${TMUX:-}" ]; then
    tmux new-window -n "$WIN" -c "$WT" "claude $CLAUDE_FLAGS$(printf '%q' "$SEED")"
    echo "${GRN}opened${RST} tmux window ${BOLD}$WIN${RST} - ctrl-b n to switch to it"
  else
    tmux new-session -d -s "$WIN" -c "$WT" "claude $CLAUDE_FLAGS$(printf '%q' "$SEED")"
    echo "${GRN}started${RST} detached tmux session ${BOLD}$WIN${RST}"
    echo "         attach with: tmux attach -t $WIN"
  fi
  echo "${DIM}         ListAgents will show it; SendMessage it to get findings back here${RST}"
else
  echo "${YEL}no tmux (or no claude) on PATH - run these two yourself:${RST}"
  echo "  cd $WT"
  echo "  claude $CLAUDE_FLAGS'$SEED'"
fi

echo "${DIM}when done: spawn-review --cleanup${RST}"
